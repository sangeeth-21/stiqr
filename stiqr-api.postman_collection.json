{
  "info": {
    "name": "StiQR API",
    "description": "StiQR API Collection — Cloudflare Workers (Hono) — live at https://stiqr-api.ksangeeth76.workers.dev\n\nRoles:\n- admin  → manages owners only (/admin/*)\n- owner  → manages their own staff only (/owner/*)\n- staff  → no management access\n\nAuthentication:\n- POST /auth/login returns accessToken (15 min) + refreshToken (30 days).\n- Send access tokens as: Authorization: Bearer {{accessToken}}\n- When the access token expires, call POST /auth/refresh with the refreshToken.\n- Login request auto-saves accessToken / refreshToken and the role-scoped adminToken / ownerToken collection variables.\n\nVariables:\n- baseUrl: https://stiqr-api.ksangeeth76.workers.dev\n- accessToken: regular session token (from login)\n- adminToken: token for admin routes\n- ownerToken: token for owner routes\n- refreshToken: rotation token\n\nPasswords must be 8+ chars with uppercase, lowercase, number and special character.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://stiqr-api.ksangeeth76.workers.dev", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "ownerToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "ownerId", "value": "", "type": "string" },
    { "key": "staffId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Authentication",
      "description": "Login, token refresh/rotation, logout, registration and password management.",
      "item": [
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@stiqr.com\",\n  \"password\": \"YourPassword@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Log in and receive an access token (15 min) plus a refresh token (30 days). Auto-saves accessToken / refreshToken / adminToken / ownerToken collection variables. Brute-force protected: 5 failed attempts locks the account for 15 minutes."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "  if (json.user && json.user.role === 'admin') pm.collectionVariables.set('adminToken', json.accessToken);",
                  "  if (json.user && json.user.role === 'owner') pm.collectionVariables.set('ownerToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Rotate the refresh token and receive a new accessToken + refreshToken pair. Old refresh tokens are revoked on every use (rotation)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Revoke the current refresh token (requires a valid access token)."
          },
          "response": []
        },
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Shop Owner\",\n  \"email\": \"owner@example.com\",\n  \"password\": \"Owner@1234\",\n  \"role\": \"owner\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Create a user. Role-scoped: admins may create owners, owners may create staff. Role: owner | staff."
          },
          "response": []
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Return the current user profile, status and effective permissions."
          },
          "response": []
        },
        {
          "name": "POST /auth/change-password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"OldPass@123\",\n  \"newPassword\": \"NewPass@456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "change-password"]
            },
            "description": "Change your own password. Revokes all active sessions for the account."
          },
          "response": []
        }
      ]
    },
