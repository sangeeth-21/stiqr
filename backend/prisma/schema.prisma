  severity      String   @default("ERROR") // WARN, ERROR, FATAL
  message       String
  stack         String?
  source        String?  // module name or file path
  endpoint      String?
  method        String?
  statusCode    Int?
  requestBody   String?  // JSON
  ipAddress     String?
  userAgent     String?
  metadata      String?  // JSON
  resolved      Boolean  @default(false)
  resolvedBy    String?
  resolvedAt    DateTime?
  occurrenceCount Int    @default(1)
  firstOccurrence DateTime @default(now())
  lastOccurrence  DateTime @default(now())
  createdAt     DateTime @default(now())

