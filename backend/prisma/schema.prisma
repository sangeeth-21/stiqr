datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Module 1: Core Auth ───────────────────────────────────────

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  phone          String?   @unique
  password       String
  role           String    @default("CUSTOMER")
  status         String    @default("PENDING_VERIFICATION")
  avatar         String?
  emailVerified  Boolean   @default(false)
  phoneVerified  Boolean   @default(false)
  lastLoginAt    DateTime?
  lastActiveAt   DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  shopId         String?
  shop           Shop?     @relation(fields: [shopId], references: [id])
  tenantId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  sessions          Session[]
  otps              Otp[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  blacklistedTokens TokenBlacklist[]
  deviceTokens      DeviceToken[]
  loginHistory      LoginHistory[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@index([shopId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  deviceInfo   String?
  location     String?
  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  sessionId String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model TokenBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("token_blacklist")
}

model Shop {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  description     String?
  logo            String?
  address         String?
  phone           String?
  email           String?
  gstNumber       String?
  panNumber       String?
  taxConfig       String?
  invoiceTemplate String?
  businessHours   String?
  bankDetails     String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  users     User[]
  settings  Setting[]
  branches  Branch[]
  customers Customer[]
  suppliers Supplier[]
  products  Product[]

  @@map("shops")
}

model Setting {
  id        String   @id @default(uuid())
  shopId    String?
  shop      Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  key       String
  value     String
  type      String   @default("string")
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, key])
  @@map("settings")
}

model Otp {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String?
  phone       String?
  code        String
  type        String
  purpose     String
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  isUsed      Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([phone])
  @@map("otps")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  oldValues String?
  newValues String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  device    String?
  location  String?
  status    String   @default("SUCCESS")
  failedReason String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("login_history")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String   @unique
  code          String   @unique
  description   String?
  monthlyPrice  Float    @default(0)
  yearlyPrice   Float    @default(0)
  maxUsers      Int      @default(5)
  maxShops      Int      @default(1)
  maxProducts   Int      @default(500)
  maxStaff      Int      @default(10)
  trialDays     Int      @default(14)
  features      String?  // JSON
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model SubscriptionHistory {
  id             String   @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  action         String   // CREATED, RENEWED, UPGRADED, DOWNGRADED, EXPIRED, CANCELLED
  oldPlan        String?
  newPlan        String?
  oldEndDate     DateTime?
  newEndDate     DateTime?
  amount         Float    @default(0)
  paymentRef     String?
  notes          String?
  createdAt      DateTime @default(now())

  @@index([subscriptionId])
  @@map("subscription_history")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      String?
  isRead    Boolean   @default(false)
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String
  subject   String?
  body      String
  variables String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

model OtpBlacklist {
  id        String   @id @default(uuid())
  code      String
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otp_blacklist")
}

model UploadedFile {
  id           String    @id @default(uuid())
  originalName String
  fileName     String
  mimeType     String
  size         Int
  path         String
  url          String?
  uploadedBy   String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@map("uploaded_files")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("device_tokens")
}

model ApiLog {
  id           String   @id @default(uuid())
  method       String
  path         String
  statusCode   Int
  responseTime Int
  ipAddress    String?
  userAgent    String?
  userId       String?
  requestBody  String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([path])
  @@map("api_logs")
}

// ─── Module 2: Tenant & Subscription ───────────────────────────

model Tenant {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  email        String?
  phone        String?
  address      String?
  logo         String?
  isActive     Boolean   @default(true)
  settings     String?
  storageLimit Int       @default(1073741824)
  storageUsed  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  subscriptions Subscription[]

  @@map("tenants")
}

model Subscription {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan           String
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  status         String    @default("ACTIVE")
  startDate      DateTime
  endDate        DateTime?
  autoRenew      Boolean   @default(false)
  maxUsers       Int       @default(5)
  maxShops       Int       @default(1)
  maxProducts    Int       @default(500)
  monthlyPrice   Float     @default(0)
  yearlyPrice    Float     @default(0)
  paymentHistory String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  history SubscriptionHistory[]

  @@index([tenantId])
  @@map("subscriptions")
}

// ─── Module 2: Branch ──────────────────────────────────────────

model Branch {
  id        String    @id @default(uuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  address   String?
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  isDefault Boolean   @default(false)
  managerId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sales     Sale[]
  employees Employee[]

  @@index([shopId])
  @@map("branches")
}

// ─── Module 2: Customer ────────────────────────────────────────

model Customer {
  id                 String    @id @default(uuid())
  shopId             String
  shop               Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name               String
  email              String?
  phone              String?
  address            String?
  groupId            String?
  walletBalance      Float     @default(0)
  loyaltyPoints      Int       @default(0)
  creditLimit        Float     @default(0)
  outstandingBalance Float     @default(0)
  notes              String?
  kycVerified        Boolean   @default(false)
  kycDocuments       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  sales               Sale[]
  serviceRepairs      ServiceRepair[]
  warranties          Warranty[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([shopId])
  @@index([phone])
  @@map("customers")
}

// ─── Module 2: Supplier ────────────────────────────────────────

model Supplier {
  id                 String    @id @default(uuid())
  shopId             String
  shop               Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name               String
  email              String?
  phone              String?
  address            String?
  contactPerson      String?
  paymentTerms       String?
  bankDetails        String?
  outstandingBalance Float     @default(0)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  purchases Purchase[]
  products  Product[]

  @@index([shopId])
  @@map("suppliers")
}

// ─── Module 2: Employee ────────────────────────────────────────

model Employee {
  id          String    @id @default(uuid())
  userId      String?
  shopId      String
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  name        String
  email       String?
  phone       String?
  designation String?
  salary      Float?
  shiftStart  String?
  shiftEnd    String?
  joinDate    DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  serviceRepairs ServiceRepair[]
  attendance     Attendance[]
  leaves         Leave[]

  @@index([shopId])
  @@index([branchId])
  @@map("employees")
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT")
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
  @@index([date])
  @@map("attendance")
}

model Leave {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String
  startDate  DateTime
  endDate    DateTime
  status     String   @default("PENDING")
  notes      String?
  approvedBy String?
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@map("leaves")
}

// ─── Module 2: Product Catalog ─────────────────────────────────

model Category {
  id        String   @id @default(uuid())
  shopId    String?
  name      String
  slug      String
  parentId  String?
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([shopId, slug])
  @@index([shopId])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid())
  shopId      String?
  name        String
  slug        String
  logo        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@unique([shopId, slug])
  @@index([shopId])
  @@map("brands")
}

model Unit {
  id        String   @id @default(uuid())
  shopId    String?
  name      String
  symbol    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([shopId, symbol])
  @@index([shopId])
  @@map("units")
}

model Product {
  id             String    @id @default(uuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  sku            String?
  barcode        String?
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  brandId        String?
  brand          Brand?    @relation(fields: [brandId], references: [id])
  unitId         String?
  unit           Unit?     @relation(fields: [unitId], references: [id])
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  purchasePrice  Float     @default(0)
  sellingPrice   Float     @default(0)
  compareAtPrice Float?
  taxRate        Float     @default(0)
  taxType        String    @default("GST")
  hsnCode        String?
  images         String?
  status         String    @default("ACTIVE")
  isFeatured     Boolean   @default(false)
  minStock       Int       @default(0)
  maxStock       Int?
  warranty       Int?
  hasVariants    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  variants       ProductVariant[]
  productImages  ProductImage[]
  stock          Stock[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  barcodes       Barcode[]
  imeiRecords    ImeiRecord[]
  warranties     Warranty[]

  @@index([shopId])
  @@index([categoryId])
  @@index([brandId])
  @@index([sku])
  @@index([barcode])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  barcode    String?
  price      Float    @default(0)
  costPrice  Float?
  stockQty   Int      @default(0)
  attributes String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stocks         Stock[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  barcodes       Barcode[]
  imeiRecords    ImeiRecord[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// ─── Module 2: Inventory & Warehouse ───────────────────────────

model Warehouse {
  id        String   @id @default(uuid())
  shopId    String
  name      String
  address   String?
  managerId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock          Stock[]
  stockMovements StockMovement[]

  @@index([shopId])
  @@map("warehouses")
}

model Stock {
  id          String          @id @default(uuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  warehouseId String?
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id])
  quantity    Int             @default(0)
  reserved    Int             @default(0)
  damaged     Int             @default(0)
  batch       String?
  expiryDate  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([productId, variantId, warehouseId, batch])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock")
}

model StockMovement {
  id          String          @id @default(uuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  warehouseId String?
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id])
  type        String
  quantity    Int
  reference   String?
  notes       String?
  createdBy   String?
  createdAt   DateTime        @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

// ─── Module 2: Barcode & IMEI ──────────────────────────────────

model Barcode {
  id        String          @id @default(uuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  code      String          @unique
  type      String          @default("EAN13")
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([code])
  @@map("barcodes")
}

model ImeiRecord {
  id             String          @id @default(uuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  imei           String          @unique
  serialNumber   String?
  status         String          @default("IN_STOCK")
  warrantyExpiry DateTime?
  soldAt         DateTime?
  soldTo         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  serviceRepairs ServiceRepair[]

  @@index([productId])
  @@index([imei])
  @@index([status])
  @@map("imei_records")
}

// ─── Module 2: Purchase ────────────────────────────────────────

model Purchase {
  id            String    @id @default(uuid())
  shopId        String
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  warehouseId   String?
  invoiceNumber String
  date          DateTime  @default(now())
  subtotal      Float     @default(0)
  taxAmount     Float     @default(0)
  discount      Float     @default(0)
  total         Float     @default(0)
  paidAmount    Float     @default(0)
  status        String    @default("PENDING")
  paymentStatus String    @default("UNPAID")
  notes         String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items PurchaseItem[]

  @@index([shopId])
  @@index([supplierId])
  @@index([invoiceNumber])
  @@map("purchases")
}

model PurchaseItem {
  id         String          @id @default(uuid())
  purchaseId String
  purchase   Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  quantity   Int
  unitPrice  Float
  taxRate    Float           @default(0)
  taxAmount  Float           @default(0)
  total      Float           @default(0)
  received   Int             @default(0)
  batch      String?
  expiryDate DateTime?
  createdAt  DateTime        @default(now())

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ─── Module 2: Sales & POS ─────────────────────────────────────

model Sale {
  id            String    @id @default(uuid())
  shopId        String
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  invoiceNumber String
  date          DateTime  @default(now())
  subtotal      Float     @default(0)
  taxAmount     Float     @default(0)
  discount      Float     @default(0)
  couponId      String?
  total         Float     @default(0)
  paidAmount    Float     @default(0)
  dueAmount     Float     @default(0)
  paymentMethod String    @default("CASH")
  status        String    @default("COMPLETED")
  notes         String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items    SaleItem[]
  payments Payment[]

  @@index([shopId])
  @@index([customerId])
  @@index([invoiceNumber])
  @@index([date])
  @@map("sales")
}

model SaleItem {
  id        String          @id @default(uuid())
  saleId    String
  sale      Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Float
  discount  Float           @default(0)
  taxRate   Float           @default(0)
  taxAmount Float           @default(0)
  total     Float           @default(0)
  imeiIds   String?
  createdAt DateTime        @default(now())

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model PosSession {
  id             String    @id @default(uuid())
  shopId         String
  branchId       String?
  cashierId      String?
  openingBalance Float     @default(0)
  closingBalance Float?
  totalSales     Float     @default(0)
  totalReturns   Float     @default(0)
  status         String    @default("OPEN")
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([shopId])
  @@map("pos_sessions")
}

// ─── Module 2: Payment ─────────────────────────────────────────

model Payment {
  id          String   @id @default(uuid())
  shopId      String
  entityType  String
  entityId    String
  saleId      String?
  sale        Sale?    @relation(fields: [saleId], references: [id])
  method      String
  amount      Float
  reference   String?
  notes       String?
  processedAt DateTime @default(now())
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([shopId])
  @@index([entityType, entityId])
  @@index([saleId])
  @@map("payments")
}

// ─── Module 2: Invoice ─────────────────────────────────────────

model Invoice {
  id            String    @id @default(uuid())
  shopId        String
  entityType    String
  entityId      String
  invoiceNumber String
  date          DateTime  @default(now())
  dueDate       DateTime?
  subtotal      Float     @default(0)
  taxAmount     Float     @default(0)
  discount      Float     @default(0)
  total         Float     @default(0)
  paidAmount    Float     @default(0)
  status        String    @default("DRAFT")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([shopId])
  @@index([invoiceNumber])
  @@index([entityType, entityId])
  @@map("invoices")
}

// ─── Module 2: Expense & Income ────────────────────────────────

model Expense {
  id            String   @id @default(uuid())
  shopId        String
  branchId      String?
  category      String
  description   String
  amount        Float
  date          DateTime @default(now())
  paymentMethod String   @default("CASH")
  reference     String?
  receipt       String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shopId])
  @@index([category])
  @@index([date])
  @@map("expenses")
}

model Income {
  id            String   @id @default(uuid())
  shopId        String
  branchId      String?
  source        String
  description   String
  amount        Float
  date          DateTime @default(now())
  paymentMethod String   @default("CASH")
  reference     String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shopId])
  @@index([source])
  @@index([date])
  @@map("income")
}

// ─── Module 2: GST & Tax ───────────────────────────────────────

model TaxRule {
  id        String   @id @default(uuid())
  shopId    String?
  name      String
  rate      Float
  type      String   @default("GST")
  hsnCode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@map("tax_rules")
}

// ─── Module 2: Loyalty & Coupons ───────────────────────────────

model LoyaltyProgram {
  id             String   @id @default(uuid())
  shopId         String
  name           String
  pointsPerRupee Float    @default(1)
  minPurchase    Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shopId])
  @@map("loyalty_programs")
}

model LoyaltyTransaction {
  id         String   @id @default(uuid())
  shopId     String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  type       String
  points     Int
  reference  String?
  notes      String?
  createdAt  DateTime @default(now())

  @@index([shopId])
  @@index([customerId])
  @@map("loyalty_transactions")
}

model Coupon {
  id          String    @id @default(uuid())
  shopId      String
  code        String
  type        String
  value       Float
  minPurchase Float     @default(0)
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  productIds  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([shopId, code])
  @@index([shopId])
  @@index([code])
  @@map("coupons")
}

// ─── Module 2: Service & Repair ────────────────────────────────

model ServiceRepair {
  id               String    @id @default(uuid())
  shopId           String
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  branchId         String?
  technicianId     String?
  technician       Employee? @relation(fields: [technicianId], references: [id])
  ticketNumber     String
  deviceType       String
  deviceBrand      String?
  deviceModel      String?
  imei             String?
  imeiRecordId     String?
  issueDescription String
  status           String    @default("RECEIVED")
  estimatedCost    Float?
  actualCost       Float?
  sparePartsCost   Float     @default(0)
  laborCost        Float     @default(0)
  deliveryDate     DateTime?
  notes            String?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items      ServiceRepairItem[]
  ImeiRecord ImeiRecord?         @relation(fields: [imeiRecordId], references: [id])

  @@index([shopId])
  @@index([customerId])
  @@index([ticketNumber])
  @@index([status])
  @@map("service_repairs")
}

model ServiceRepairItem {
  id              String        @id @default(uuid())
  serviceRepairId String
  serviceRepair   ServiceRepair @relation(fields: [serviceRepairId], references: [id], onDelete: Cascade)
  productId       String?
  productName     String
  quantity        Int           @default(1)
  price           Float         @default(0)
  createdAt       DateTime      @default(now())

  @@index([serviceRepairId])
  @@map("service_repair_items")
}

// ─── Module 2: Warranty ────────────────────────────────────────

model Warranty {
  id         String    @id @default(uuid())
  shopId     String
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  saleId     String?
  imei       String?
  type       String    @default("PRODUCT")
  startDate  DateTime
  endDate    DateTime
  terms      String?
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([shopId])
  @@index([productId])
  @@index([customerId])
  @@index([imei])
  @@index([status])
  @@map("warranties")
}

// ─── Module 2: Accounting ──────────────────────────────────────

model Ledger {
  id          String   @id @default(uuid())
  shopId      String
  entityType  String?
  entityId    String?
  type        String
  description String
  debit       Float    @default(0)
  credit      Float    @default(0)
  balance     Float    @default(0)
  date        DateTime @default(now())
  reference   String?
  createdAt   DateTime @default(now())

  journalLines JournalLine[]

  @@index([shopId])
  @@index([entityType, entityId])
  @@index([date])
  @@map("ledgers")
}

model Journal {
  id          String   @id @default(uuid())
  shopId      String
  entryDate   DateTime
  description String
  reference   String?
  createdAt   DateTime @default(now())

  lines JournalLine[]

  @@index([shopId])
  @@index([entryDate])
  @@map("journals")
}

model JournalLine {
  id          String   @id @default(uuid())
  journalId   String
  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  ledgerId    String?
  ledger      Ledger?  @relation(fields: [ledgerId], references: [id])
  debit       Float    @default(0)
  credit      Float    @default(0)
  description String?
  createdAt   DateTime @default(now())

  @@index([journalId])
  @@index([ledgerId])
  @@map("journal_lines")
}

// ─── Module 2: Reports ─────────────────────────────────────────

model Report {
  id          String   @id @default(uuid())
  shopId      String
  type        String
  parameters  String?
  data        String?
  generatedBy String?
  generatedAt DateTime @default(now())

  @@index([shopId])
  @@index([type])
  @@index([generatedAt])
  @@map("reports")
}

// ============================================================
// MODULE 3: FinTech, Payments & Financial Services
// ============================================================

model Wallet {
  id               String    @id @default(uuid())
  shopId           String
  holderType       String    // SHOP, AGENT, DISTRIBUTOR, RETAILER, CUSTOMER
  holderId         String
  balance          Float     @default(0)
  holdBalance      Float     @default(0)
  reservedBalance  Float     @default(0)
  status           String    @default("ACTIVE") // ACTIVE, FROZEN, CLOSED
  currency         String    @default("INR")
  dailyLimit       Float     @default(100000)
  monthlyLimit     Float     @default(1000000)
  currentDayUsage  Float     @default(0)
  currentMonthUsage Float    @default(0)
  lastUsageReset   DateTime?
  frozenAt         DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  transactions     WalletTransaction[]
  ledger           WalletLedger[]
  settlements      Settlement[]

  @@unique([shopId, holderType, holderId])
  @@index([shopId])
  @@index([holderType, holderId])
  @@index([status])
  @@map("wallets")
}

model WalletTransaction {
  id                 String    @id @default(uuid())
  walletId           String
  type               String    // CREDIT, DEBIT, REVERSAL, REFUND, HOLD, RELEASE
  amount             Float
  balance            Float     // running balance after transaction
  referenceType      String?
  referenceId        String?
  referenceNumber    String?
  description        String?
  status             String    @default("PENDING") // INITIATED, PENDING, PROCESSING, SUCCESS, FAILED, CANCELLED
  idempotencyKey     String?   @unique
  providerReference  String?
  metadata           String?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  wallet             Wallet    @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model WalletLedger {
  id           String   @id @default(uuid())
  walletId     String
  transactionId String?
  type         String   // CREDIT, DEBIT, ADJUSTMENT, COMMISSION, SETTLEMENT, FEE
  amount       Float
  balanceAfter Float
  description  String?
  referenceType String?
  referenceId  String?
  createdBy    String?
  createdAt    DateTime @default(now())

  wallet       Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([transactionId])
  @@index([type])
  @@index([createdAt])
  @@map("wallet_ledgers")
}

model CommissionRule {
  id              String    @id @default(uuid())
  shopId          String
  name            String
  serviceType     String    // DMT, AEPS, BBPS, RECHARGE, PAYMENT, ALL
  calculationType String    // PERCENTAGE, FIXED, SLAB
  rate            Float     @default(0)
  minAmount       Float     @default(0)
  maxAmount       Float     @default(999999999)
  minCommission   Float     @default(0)
  maxCommission   Float     @default(999999)
  targetRole      String    // DISTRIBUTOR, RETAILER, AGENT
  isActive        Boolean   @default(true)
  priority        Int       @default(0)
  validFrom       DateTime?
  validTo         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  slabs           CommissionSlab[]
  ledger          CommissionLedger[]

  @@index([shopId])
  @@index([serviceType])
  @@index([isActive])
  @@map("commission_rules")
}

model CommissionSlab {
  id          String   @id @default(uuid())
  ruleId      String
  minAmount   Float
  maxAmount   Float
  rate        Float    @default(0)
  fixedAmount Float    @default(0)
  createdAt   DateTime @default(now())

  rule        CommissionRule @relation(fields: [ruleId], references: [id])

  @@index([ruleId])
  @@map("commission_slabs")
}

model CommissionLedger {
  id                String   @id @default(uuid())
  shopId            String
  ruleId            String?
  transactionType   String
  transactionId     String?
  amount            Float
  commissionAmount  Float
  targetShopId      String?
  targetHolderType  String?
  targetHolderId    String?
  status            String   @default("PENDING") // PENDING, PAID, REVERSED
  paidAt            DateTime?
  settledAt         DateTime?
  createdAt         DateTime @default(now())

  rule              CommissionRule? @relation(fields: [ruleId], references: [id])

  @@index([shopId])
  @@index([targetShopId])
  @@index([status])
  @@index([createdAt])
  @@map("commission_ledgers")
}

model Settlement {
  id                String    @id @default(uuid())
  shopId            String
  walletId          String
  amount            Float
  charges           Float     @default(0)
  netAmount         Float
  bankAccountNumber String
  bankName          String?
  ifscCode          String
  accountHolderName String
  status            String    @default("REQUESTED") // REQUESTED, APPROVED, PROCESSING, COMPLETED, FAILED
  utrNumber         String?
  processedBy       String?
  processedAt       DateTime?
  failureReason     String?
  retryCount        Int       @default(0)
  nextRetryAt       DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  wallet            Wallet    @relation(fields: [walletId], references: [id])

  @@index([shopId])
  @@index([status])
  @@index([createdAt])
  @@map("settlements")
}

model DMTSender {
  id                String    @id @default(uuid())
  shopId            String
  mobile            String
  name              String
  address           String?
  maxTransferLimit  Float     @default(50000)
  totalTransferred  Float     @default(0)
  kycStatus         String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  verificationOtp   String?
  otpExpiry         DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  beneficiaries     DMTBeneficiary[]
  transfers         DMTTransfer[]

  @@unique([shopId, mobile])
  @@index([shopId])
  @@map("dmt_senders")
}

model DMTBeneficiary {
  id              String    @id @default(uuid())
  senderId        String
  name            String
  bankName        String
  accountNumber   String
  ifscCode        String
  accountType     String    @default("SAVINGS") // SAVINGS, CURRENT
  mobile          String?
  nickname        String?
  isVerified      Boolean   @default(false)
  isFavourite     Boolean   @default(false)
  status          String    @default("ACTIVE") // ACTIVE, DELETED
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sender          DMTSender @relation(fields: [senderId], references: [id])
  transfers       DMTTransfer[]

  @@index([senderId])
  @@map("dmt_beneficiaries")
}

model DMTTransfer {
  id              String          @id @default(uuid())
  senderId        String
  beneficiaryId   String
  shopId          String
  amount          Float
  charges         Float           @default(0)
  totalDebited    Float
  referenceNumber String          @unique
  providerReference String?
  providerName    String?
  status          String          @default("INITIATED") // INITIATED, PENDING, PROCESSING, SUCCESS, FAILED, REFUNDED
  failureReason   String?
  initiatedAt     DateTime        @default(now())
  completedAt     DateTime?
  refundStatus    String?
  refundAmount    Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  sender          DMTSender       @relation(fields: [senderId], references: [id])
  beneficiary     DMTBeneficiary  @relation(fields: [beneficiaryId], references: [id])

  @@index([senderId])
  @@index([shopId])
  @@index([status])
  @@index([createdAt])
  @@map("dmt_transfers")
}

model AEPSTransaction {
  id                String    @id @default(uuid())
  shopId            String
  aadhaarNumber     String
  biometricType     String    // FINGERPRINT, IRIS
  transactionType   String    // BALANCE_ENQUIRY, CASH_WITHDRAWAL, CASH_DEPOSIT, MINI_STATEMENT
  amount            Float?
  bankIin           String?
  referenceNumber   String    @unique
  providerReference String?
  status            String    @default("INITIATED") // INITIATED, PENDING, SUCCESS, FAILED
  failureReason     String?
  settlementStatus  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([shopId])
  @@index([status])
  @@index([createdAt])
  @@map("aeps_transactions")
}

model BBPSBiller {
  id          String   @id @default(uuid())
  name        String
  category    String   // ELECTRICITY, WATER, GAS, BROADBAND, DTH, FASTAG, INSURANCE, LOAN, MUNICIPAL, OTHER
  providerCode String
  isActive    Boolean  @default(true)
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    BBPSBillPayment[]

  @@index([category])
  @@index([isActive])
  @@map("bbps_billers")
}

model BBPSBillPayment {
  id              String    @id @default(uuid())
  shopId          String
  billerId        String
  consumerNumber  String
  customerName    String?
  billAmount      Float
  convenienceFee  Float     @default(0)
  totalAmount     Float
  paymentMode     String?   // WALLET, UPI, CARD
  status          String    @default("BILL_FETCHED") // BILL_FETCHED, PAYMENT_INITIATED, PAYMENT_SUCCESS, PAYMENT_FAILED, REFUNDED
  receiptNumber   String?
  providerReference String?
  paidAt          DateTime?
  refundStatus    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  biller          BBPSBiller @relation(fields: [billerId], references: [id])

  @@index([shopId])
  @@index([status])
  @@index([createdAt])
  @@map("bbps_bill_payments")
}

model Recharge {
  id                 String    @id @default(uuid())
  shopId             String
  type               String    // MOBILE, DTH, DATACARD, OTT, FASTAG
  operator           String?
  operatorCode       String?
  mobileOrAccountNumber String
  amount             Float
  convenienceFee     Float     @default(0)
  totalDebited       Float
  referenceNumber    String    @unique
  providerReference  String?
  status             String    @default("INITIATED") // INITIATED, PENDING, SUCCESS, FAILED, REFUNDED
  failureReason      String?
  paidAt             DateTime?
  refundStatus       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([shopId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("recharges")
}

model PaymentGatewayTransaction {
  id              String    @id @default(uuid())
  shopId          String
  amount          Float
  currency        String    @default("INR")
  paymentMethod   String    // UPI, CREDIT_CARD, DEBIT_CARD, NET_BANKING, WALLET, QR
  provider        String    // RAZORPAY, CASHFREE, STRIPE, PHONEPE, PAYU
  providerOrderId String?
  providerPaymentId String?
  customerEmail   String?
  customerPhone   String?
  description     String?
  status          String    @default("CREATED") // CREATED, AUTHORIZED, CAPTURED, FAILED, REFUNDED
  capturedAt      DateTime?
  refundAmount    Float     @default(0)
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  webhooks        PaymentWebhook[]

  @@index([shopId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@map("payment_gateway_transactions")
}

model PaymentWebhook {
  id            String   @id @default(uuid())
  provider      String
  eventType     String
  payload       String
  signature     String?
  processed     Boolean  @default(false)
  processedAt   DateTime?
  error         String?
  createdAt     DateTime @default(now())

  transaction   PaymentGatewayTransaction? @relation(fields: [transactionId], references: [id])
  transactionId String?

  @@index([provider])
  @@index([processed])
  @@index([createdAt])
  @@map("payment_webhooks")
}

model KYC {
  id                String    @id @default(uuid())
  shopId            String
  holderType        String    // SHOP, AGENT, RETAILER, CUSTOMER
  holderId          String
  panNumber         String?
  aadhaarNumber     String?
  bankAccountNumber String?
  ifscCode          String?
  status            String    @default("NOT_STARTED") // NOT_STARTED, PENDING, VERIFIED, REJECTED
  verifiedBy        String?
  verifiedAt        DateTime?
  rejectionReason   String?
  expiryDate        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  documents         KYCDocument[]

  @@unique([shopId, holderType, holderId])
  @@index([shopId])
  @@index([status])
  @@map("kycs")
}

model KYCDocument {
  id           String   @id @default(uuid())
  kycId        String
  documentType String   // PAN, AADHAAR, BANK_STATEMENT, ADDRESS_PROOF, PHOTO
  fileUrl      String
  fileName     String?
  fileSize     Int?
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  kyc          KYC      @relation(fields: [kycId], references: [id])

  @@index([kycId])
  @@map("kyc_documents")
}

model Beneficiary {
  id              String    @id @default(uuid())
  shopId          String
  name            String
  accountNumber   String
  bankName        String
  ifscCode        String
  accountType     String    @default("SAVINGS")
  mobile          String?
  nickname        String?
  isFavourite     Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([shopId])
  @@map("beneficiaries")
}

model FinancialTransaction {
  id                String    @id @default(uuid())
  shopId            String
  type              String    // DMT, AEPS, BBPS, RECHARGE, PAYMENT, WALLET_TOPUP, COMMISSION, SETTLEMENT
  referenceType     String?
  referenceId       String?
  amount            Float
  charges           Float     @default(0)
  totalAmount       Float
  walletBefore      Float?
  walletAfter       Float?
  status            String    @default("INITIATED") // INITIATED, PENDING, PROCESSING, SUCCESS, FAILED, REFUNDED, REVERSED, CANCELLED
  provider          String?
  providerReference String?
  failureReason     String?
  initiatedBy       String?
  ipAddress         String?
  deviceInfo        String?
  riskScore         Float     @default(0)
  metadata          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  logs              TransactionLog[]
  refund            Refund[]

  @@index([shopId])
  @@index([type])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("financial_transactions")
}

model TransactionLog {
  id            String   @id @default(uuid())
  transactionId String
  action        String
  status        String
  message       String?
  metadata      String?
  createdAt     DateTime @default(now())

  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@index([createdAt])
  @@map("transaction_logs")
}

model Reconciliation {
  id                 String   @id @default(uuid())
  date               DateTime
  shopId             String?
  serviceType        String
  totalTransactions  Int      @default(0)
  matchedCount       Int      @default(0)
  mismatchedCount    Int      @default(0)
  missingCount       Int      @default(0)
  status             String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  reconciledBy       String?
  reconciledAt       DateTime?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  logs               ReconciliationLog[]

  @@index([shopId])
  @@index([date])
  @@index([status])
  @@map("reconciliations")
}

model ReconciliationLog {
  id                String   @id @default(uuid())
  reconciliationId  String
  transactionId     String?
  providerReference String?
  platformAmount    Float
  providerAmount    Float
  status            String   // MATCHED, MISMATCHED, MISSING_ON_PLATFORM, MISSING_ON_PROVIDER
  resolution        String?
  resolvedBy        String?
  resolvedAt        DateTime?
  createdAt         DateTime @default(now())

