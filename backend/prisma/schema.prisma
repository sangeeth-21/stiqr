  description   String?
  isEnabled     Boolean  @default(false)
  valueType     String?  // BOOLEAN, STRING, NUMBER, JSON
  defaultValue  String?
  allowedRoles  String?  // JSON array of role names
  shopOverrides String?  // JSON map of shopId -> value
  percentage    Int?     // percentage rollout 0-100
  metadata      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("feature_flags")
}

model SystemAnnouncement {
  id            String   @id @default(uuid())
  title         String
  message       String
