  approvedAt             DateTime?
  processedAt            DateTime?
  utrNumber              String?
  failureReason          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  transaction            FinancialTransaction @relation(fields: [originalTransactionId], references: [id])

  @@index([shopId])
  @@index([originalTransactionId])
  @@index([status])
  @@index([createdAt])
  @@map("refunds")
}

model FraudRule {
  id         String   @id @default(uuid())
  name       String
  ruleType   String   // VELOCITY, LIMIT, BLACKLIST, GEOLOCATION, DEVICE, DUPLICATE
