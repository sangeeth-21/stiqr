  originalUrl   String
  processedUrl  String?
  status        String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  ocrEngine     String?  // TESSERACT, GOOGLE_VISION, AWS_TEXTRACT, AZURE FormRecognizer
  extractedData String?  // JSON with extracted fields
  confidence    Float?
  errorMessage  String?
  metadata      String?  // JSON
  processedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shopId])
  @@index([userId])
  @@index([documentType])
  @@index([status])
  @@index([createdAt])
  @@map("ocr_documents")
}

model AutomationRule {
  id            String   @id @default(uuid())
  shopId        String?
  name          String
  description   String?
  triggerType   String   // SCHEDULE, EVENT, MANUAL
  triggerConfig String?  // JSON - cron expression, event name, etc.
  actionType    String   // WEBHOOK, EMAIL, SMS, NOTIFICATION, UPDATE_DB, API_CALL
  actionConfig  String?  // JSON - action configuration
  conditions    String?  // JSON - filter conditions
  isActive      Boolean  @default(true)
  lastRunAt     DateTime?
  lastStatus    String?  // SUCCESS, FAILED, RUNNING
  lastError     String?
  runCount      Int      @default(0)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  executions    AutomationExecution[]

  @@index([shopId])
  @@index([triggerType])
  @@index([isActive])
  @@map("automation_rules")
}

model AutomationExecution {
  id            String   @id @default(uuid())
  ruleId        String
  status        String   @default("RUNNING") // RUNNING, SUCCESS, FAILED, SKIPPED
  input         String?  // JSON
  output        String?  // JSON
  error         String?
  durationMs    Int?
  triggeredBy   String?  // SCHEDULE, MANUAL, EVENT
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  rule          AutomationRule @relation(fields: [ruleId], references: [id])

  @@index([ruleId])
  @@index([status])
  @@index([startedAt])
  @@map("automation_executions")
}

model ScheduledJob {
  id            String   @id @default(uuid())
  name          String
  description   String?
  jobType       String   // REPORT, BACKUP, CLEANUP, SYNC, NOTIFICATION, CUSTOM
  schedule      String   // cron expression
  config        String?  // JSON job configuration
  isActive      Boolean  @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  lastStatus    String?
  runCount      Int      @default(0)
  failureCount  Int      @default(0)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([jobType])
  @@map("scheduled_jobs")
}

model Backup {
  id            String   @id @default(uuid())
  name          String
  type          String   // FULL, INCREMENTAL, FILES, DATABASE
  status        String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
