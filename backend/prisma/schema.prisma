  severity   String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  isActive   Boolean  @default(true)
  action     String   @default("ALERT") // ALERT, BLOCK, FREEZE_WALLET, REVIEW
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  alerts     FraudAlert[]

  @@index([isActive])
  @@index([ruleType])
  @@map("fraud_rules")
}

model FraudAlert {
  id            String    @id @default(uuid())
  ruleId        String?
  transactionId String?
  shopId        String
  alertType     String
  description   String?
  riskScore     Float     @default(0)
  status        String    @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, FALSE_POSITIVE
  assignedTo    String?
  resolvedAt    DateTime?
  resolution    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  rule          FraudRule? @relation(fields: [ruleId], references: [id])

  @@index([shopId])
  @@index([status])
  @@index([createdAt])
  @@map("fraud_alerts")
}

model Blacklist {
  id           String    @id @default(uuid())
  entityType   String    // MOBILE, AADHAAR, EMAIL, IP, DEVICE, ACCOUNT
  entityValue  String
  reason       String?
  expiresAt    DateTime?
  addedBy      String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([entityType, entityValue])
  @@index([entityType])
  @@index([isActive])
  @@map("blacklists")
}

model ProviderConfig {
  id                String   @id @default(uuid())
  provider          String
  serviceType       String
  apiEndpoint       String?
  apiKeyEncrypted   String?
  apiSecretEncrypted String?
  merchantId        String?
  isActive          Boolean  @default(true)
  config            String?  // JSON
  priority          Int      @default(0)
  failoverProviderId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, serviceType])
  @@index([serviceType])
  @@map("provider_configs")
}

model ProviderLog {
  id              String   @id @default(uuid())
  provider        String
  serviceType     String?
  requestUrl      String?
  requestBody     String?
  responseBody    String?
  statusCode      Int?
  latency         Int?
  success         Boolean  @default(true)
  error           String?
  transactionId   String?
  createdAt       DateTime @default(now())

  @@index([provider])
  @@index([success])
  @@index([createdAt])
  @@map("provider_logs")
}

