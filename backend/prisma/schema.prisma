  status        String   @default("INSTALLED") // INSTALLED, ENABLED, DISABLED, UPDATING, ERROR
  configSchema  String?  // JSON schema for configuration
  config        String?  // JSON current configuration
  permissions   String?  // JSON array of permissions required
  hooks         String?  // JSON - registered hooks/endpoints
  minVersion    String?  // minimum platform version
  dependencies  String?  // JSON array of dependency plugin names
  installedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@map("plugins")
}

model APIKey {
  id            String   @id @default(uuid())
  shopId        String?
