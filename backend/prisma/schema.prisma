}

model IntegrationLog {
  id            String   @id @default(uuid())
  integrationId String
  direction     String   // INBOUND, OUTBOUND
  eventType     String?  // specific event that triggered
  requestUrl    String?
  requestBody   String?
  responseStatus Int?
  responseBody  String?
  success       Boolean  @default(true)
  error         String?
  latencyMs     Int?
