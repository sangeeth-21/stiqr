  @@index([errorType])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
  @@map("error_logs")
}

model Integration {
  id            String   @id @default(uuid())
  shopId        String?
  name          String
  type          String   // WHATSAPP, EMAIL, SMS, PAYMENT, ERP, CRM, SHIPPING, ECOMMERCE, ACCOUNTING
