  error         String?
  durationMs    Int?
  metadata      String?  // JSON - table counts, etc.
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("backups")
}

model FeatureFlag {
