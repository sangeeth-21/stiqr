  status        String   @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, DISMISSED
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shopId])
  @@index([alertType])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
  @@map("security_alerts")
}

model BlockedIP {
  id            String   @id @default(uuid())
  ipAddress     String   @unique
